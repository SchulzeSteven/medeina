{
  "name": "medaina-coaching",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "watch": "ng build --watch",
    "build:medeina": "ng build --configuration production --base-href /medeina/",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "start:api": "php -S 127.0.0.1:8081 -t public",
    "check:inquiry": "node scripts/check-inquiry.cjs",
    "check:languages": "node scripts/check-languages.cjs"
  },
  "dependencies": {
    "@angular/common": "~20.3.0",
    "@angular/compiler": "~20.3.0",
    "@angular/core": "~20.3.0",
    "@angular/forms": "~20.3.0",
    "@angular/platform-browser": "~20.3.0",
    "@angular/router": "~20.3.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "~20.3.0",
    "@angular/cli": "~20.3.0",
    "@prettier/plugin-php": "^0.26.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.2"
  }
}
